# Template for the .env.production file that lives on the droplet, next to
# compose.production.yaml. Never commit the filled-in copy.
#
# The deploy job aborts before restarting anything when this file is missing or
# when AUTH_SECRET or GO_API_URL is blank.

# At least 32 characters: openssl rand -base64 48
# Must not reuse APP_JWT_SECRET from the Go backend.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Login lifetime in seconds. Keep equal to backend APP_JWT_TTL; shorter value
# wins because both Auth.js session and Go API token must remain valid.

# Public origin of this app. Auth.js builds the Discord callback URL from it,
# so the Discord application must list <AUTH_URL>/api/auth/callback/discord as
# an authorised redirect URI.
AUTH_URL=https://replace-with-your-domain

AUTH_DISCORD_ID=replace-with-your-discord-application-id
AUTH_DISCORD_SECRET=replace-with-your-discord-client-secret

# Go web API, reached from the Next.js server process only, never the browser.
# This is a Docker service name on the backend's compose network: the API
# publishes to the host's loopback, which is unreachable from inside a
# container. See the networks block in compose.production.yaml.
GO_API_URL=http://api:8080

# Host-side publish target, proxied by Caddy. Port 3000 is already taken on the
# droplet by another app.
FRONTEND_PORT=3001
